<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="550" prefWidth="900" style="-fx-background-color: #2E7D32; -fx-padding: 0;" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartfarm.controller.LoginController">

    <VBox fx:id="leftPanel" alignment="CENTER_LEFT" prefHeight="550.0" prefWidth="403.0" spacing="15" styleClass="left-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0">

        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>


        <VBox fx:id="loginView" spacing="15">

            <Label styleClass="welcome-label" text="Welcome Back" />
            <Label styleClass="title-label" text="Log In" />

            <Label styleClass="field-label" text="Email or Phone" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-wrapper">
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/email_icon.png" />
                    </image>
                </ImageView>
                <TextField fx:id="emailField" promptText="Enter your email or phone" styleClass="input-field-flat" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label styleClass="field-label" text="Password" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-wrapper">
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png" />
                    </image>
                </ImageView>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field-flat" HBox.hgrow="ALWAYS" />
                <TextField fx:id="visiblePasswordField" managed="false" promptText="Enter your password" styleClass="input-field-flat" visible="false" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleShowHidePassword" styleClass="show-hide-btn">
                    <graphic>
                        <ImageView fx:id="passwordEyeIcon" fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/eye_closed.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <HBox alignment="CENTER_RIGHT">
                <Hyperlink onAction="#handleForgotPassword" styleClass="forgot-link" text="Forgot Password?" />
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label" />

            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" styleClass="login-btn" text="Log In" />

            <HBox alignment="CENTER" spacing="5">
                <Label styleClass="small-label" text="Don't have an account?" />
                <Hyperlink onAction="#handleSignUp" styleClass="signup-link" text="Sign Up" />
            </HBox>

        </VBox>


        <VBox fx:id="forgotView" managed="false" spacing="15" visible="false">

            <Label styleClass="welcome-label" text="." />
            <Label styleClass="title-label" text="Forgot Password" />

            <Label styleClass="field-label" text="Email or Phone" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-wrapper">
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/email_icon.png" />
                    </image>
                </ImageView>
                <TextField fx:id="forgotEmailField" promptText="Enter your email or phone" styleClass="input-field-flat" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label styleClass="field-label" text="New Password" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-wrapper">
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png" />
                    </image>
                </ImageView>
                <PasswordField fx:id="newPasswordField" promptText="Enter new password" styleClass="input-field-flat" HBox.hgrow="ALWAYS" />
                <TextField fx:id="visibleNewPasswordField" managed="false" promptText="Enter new password" styleClass="input-field-flat" visible="false" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleShowHideNewPassword" styleClass="show-hide-btn">
                    <graphic>
                        <ImageView fx:id="newPasswordEyeIcon" fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/eye_closed.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label styleClass="field-label" text="Confirm New Password" />
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-wrapper">
                <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png" />
                    </image>
                </ImageView>
                <PasswordField fx:id="confirmNewPasswordField" promptText="Confirm new password" styleClass="input-field-flat" HBox.hgrow="ALWAYS" />
                <TextField fx:id="visibleConfirmNewPasswordField" managed="false" promptText="Confirm new password" styleClass="input-field-flat" visible="false" HBox.hgrow="ALWAYS" />
                <Button onAction="#handleShowHideConfirmNewPassword" styleClass="show-hide-btn">
                    <graphic>
                        <ImageView fx:id="confirmNewPasswordEyeIcon" fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/eye_closed.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label fx:id="forgotErrorLabel" styleClass="error-label" />

            <Button fx:id="resetPasswordButton" maxWidth="Infinity" onAction="#handleResetPassword" styleClass="login-btn" text="Reset Password" />

            <HBox alignment="CENTER">
                <Hyperlink onAction="#handleBackToLogin" styleClass="signup-link" text="Back to Login" />
            </HBox>

        </VBox>

    </VBox>

    <StackPane fx:id="rightPanel" styleClass="right-panel" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="380" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox alignment="TOP_CENTER" spacing="15">
            <padding>
                <Insets top="40" />
            </padding>

            <Label fx:id="greetingLabel" styleClass="greeting-label" />

        </VBox>

        <VBox alignment="BOTTOM_CENTER" spacing="10">
            <padding>
                <Insets bottom="60" />
            </padding>
            <Label fx:id="smartFarmLabel" styleClass="right-title" text="Smart Farm Management" />
            <Label styleClass="right-subtitle" text="Manage your farm smarter" />
        </VBox>

        <ImageView fitHeight="340" fitWidth="340" pickOnBounds="true" preserveRatio="true" smooth="true">
            <image>
                <Image url="@../images/11.png" />
            </image>
        </ImageView>

    </StackPane>

    <Button fx:id="themeToggleBtn" onAction="#handleThemeToggle" styleClass="theme-btn" AnchorPane.leftAnchor="-40" AnchorPane.topAnchor="-40">
        <graphic>
            <ImageView fx:id="themeIcon" fitHeight="120" fitWidth="120">
                <image>
                    <Image url="@../images/sun.png" />
                </image>
            </ImageView>
        </graphic>
    </Button>

</AnchorPane>
