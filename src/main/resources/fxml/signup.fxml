<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartfarm.controller.SignUpController"
            prefWidth="1100" prefHeight="650"
            stylesheets="@../css/signup.css">

    <Pane fx:id="bgPane"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          styleClass="bg-pane"/>

    <Pane AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          style="-fx-background-color: rgba(0,0,0,0.3);"/>

    <StackPane AnchorPane.topAnchor="0"
               AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0"
               AnchorPane.rightAnchor="0">

        <VBox fx:id="formPanel"
              styleClass="form-panel"
              spacing="12"
              alignment="CENTER"
              maxWidth="400"
              maxHeight="520">

            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="tabs-box">
                <Label fx:id="signInTab"
                       text="Sign In"
                       styleClass="tab-inactive"
                       onMouseClicked="#handleGoToLogin"/>
                <Label fx:id="signUpTab"
                       text="Sign Up"
                       styleClass="tab-active"/>
            </HBox>

            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="nameField"
                       promptText="Enter your full name"
                       styleClass="input-field"/>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="contact-toggle-box">
                <Label fx:id="emailToggleTab" text="Email"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2E7D32; -fx-background-color: #E8F5E9; -fx-padding: 5 14 5 14; -fx-background-radius: 14; -fx-cursor: hand;"
                       onMouseClicked="#handleShowEmailField"/>
                <Label fx:id="phoneToggleTab" text="Phone"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #999999; -fx-background-color: transparent; -fx-padding: 5 14 5 14; -fx-background-radius: 14; -fx-cursor: hand;"
                       onMouseClicked="#handleShowPhoneField"/>
            </HBox>

            <StackPane>
                <HBox fx:id="emailInputBox" styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                        <image>
                            <Image url="@../images/email_icon.png"/>
                        </image>
                    </ImageView>
                    <TextField fx:id="emailField"
                               promptText="Enter your email"
                               styleClass="input-field-flat"
                               HBox.hgrow="ALWAYS"/>
                </HBox>

                <GridPane fx:id="phoneInputBox" hgap="6" visible="false" managed="false">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="32"/>
                        <ColumnConstraints percentWidth="68"/>
                    </columnConstraints>
                    <HBox styleClass="input-wrapper" alignment="CENTER" GridPane.columnIndex="0" spacing="6">
                        <ImageView fx:id="flagImage" fitWidth="28" fitHeight="20" preserveRatio="true" smooth="true">
                            <image>
                                <Image url="@../images/flags/ps.png"/>
                            </image>
                        </ImageView>
                        <TextField fx:id="countryCodeField"
                                   promptText="+970"
                                   styleClass="input-field-flat"
                                   alignment="CENTER"
                                   maxWidth="Infinity"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="1">
                        <TextField fx:id="phoneNumberField"
                                   promptText="599123456"
                                   styleClass="input-field-flat"
                                   HBox.hgrow="ALWAYS"/>
                    </HBox>
                </GridPane>
            </StackPane>

            <Label text="Password" styleClass="field-label"/>
            <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png"/>
                    </image>
                </ImageView>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password"
                               styleClass="input-field-flat"
                               HBox.hgrow="ALWAYS"/>
                <TextField fx:id="visiblePasswordField"
                           promptText="Enter your password"
                           styleClass="input-field-flat"
                           visible="false"
                           managed="false"
                           HBox.hgrow="ALWAYS"/>
                <Button styleClass="show-hide-btn"
                        onAction="#handleShowHidePassword">
                    <graphic>
                        <ImageView fx:id="passwordEyeIcon" fitWidth="18" fitHeight="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/eye_closed.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label text="Confirm Password" styleClass="field-label"/>
            <HBox styleClass="input-wrapper" alignment="CENTER_LEFT" spacing="8">
                <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                    <image>
                        <Image url="@../images/lock_icon.png"/>
                    </image>
                </ImageView>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Confirm your password"
                               styleClass="input-field-flat"
                               HBox.hgrow="ALWAYS"/>
                <TextField fx:id="visibleConfirmField"
                           promptText="Confirm your password"
                           styleClass="input-field-flat"
                           visible="false"
                           managed="false"
                           HBox.hgrow="ALWAYS"/>
                <Button styleClass="show-hide-btn"
                        onAction="#handleShowHideConfirm">
                    <graphic>
                        <ImageView fx:id="confirmEyeIcon" fitWidth="18" fitHeight="18" preserveRatio="true">
                            <image>
                                <Image url="@../images/eye_closed.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-label"/>

            <Button fx:id="signUpButton"
                    text="Sign Up"
                    styleClass="signup-btn"
                    onAction="#handleSignUp"
                    maxWidth="Infinity"/>

        </VBox>

    </StackPane>

</AnchorPane>
