<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650" prefWidth="1100" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartfarm.controller.DashboardController">

    <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox fx:id="sidebar" prefWidth="230" spacing="4" styleClass="sidebar">

            <padding>
                <Insets bottom="25" left="15" right="0" top="25" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-box">
                <padding>
                    <Insets bottom="30" left="10" right="15" />
                </padding>
                <Label styleClass="logo-icon" text="🌿" />
                <Label styleClass="logo-text" text="Smart Farm" />
            </HBox>

            <StackPane alignment="TOP_LEFT">


                <Region fx:id="slideHighlight" styleClass="slide-highlight" mouseTransparent="true" />

                <VBox fx:id="navButtons" spacing="4">
                    <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-btn" text="🏠  Dashboard" />
                    <Button fx:id="btnHistory" maxWidth="Infinity" onAction="#showHistory" styleClass="nav-btn" text="📜  History" />
                    <Button fx:id="btnFields" maxWidth="Infinity" onAction="#showFields" styleClass="nav-btn" text="🌱  Fields &amp; Crops" />
                    <Button fx:id="btnHarvests" maxWidth="Infinity" onAction="#showHarvests" styleClass="nav-btn" text="🌾  Harvests" />
                    <Button fx:id="btnWorkers" maxWidth="Infinity" onAction="#showWorkers" styleClass="nav-btn" text="👷  Workers" />
                    <Button fx:id="btnTransactions" maxWidth="Infinity" onAction="#showTransactions" styleClass="nav-btn" text="💰  Transactions" />
                    <Button fx:id="btnStorage" maxWidth="Infinity" onAction="#showStorage" styleClass="nav-btn" text="📦  Storage" />
                    <Button fx:id="btnFertilizers" maxWidth="Infinity" onAction="#showFertilizers" styleClass="nav-btn" text="👨🏼‍🌾  Fertilizers" />
                    <Button fx:id="btnReports" maxWidth="Infinity" onAction="#showReports" styleClass="nav-btn" text="📊  Reports" />
                    <Button fx:id="btnSettings" maxWidth="Infinity" onAction="#showSettings" styleClass="nav-btn" text="🔧  Settings" />
                    <Button fx:id="btnQuit" maxWidth="Infinity" onAction="#handleQuit" styleClass="nav-btn" text="🚪  Quit" />
                </VBox>

            </StackPane>

        </VBox>

        <VBox styleClass="main-area" HBox.hgrow="ALWAYS">

            <padding>
                <Insets bottom="15" left="0" right="15" top="15" />
            </padding>

            <VBox styleClass="content-wrapper" VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                    <padding>
                        <Insets bottom="18" left="30" right="30" top="18" />
                    </padding>

                    <Label fx:id="pageTitle" styleClass="page-title" text="Dashboard" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="themeToggleBtn" onAction="#handleThemeToggle" styleClass="theme-btn">
                        <graphic>
                            <ImageView fx:id="themeIcon" fitHeight="24" fitWidth="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/sun.png" />
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <HBox alignment="CENTER" spacing="10" styleClass="user-box">
                        <padding>
                            <Insets left="20" />
                        </padding>
                        <Label fx:id="userName" styleClass="user-name" text="Manager" />
                    </HBox>

                </HBox>

                <ScrollPane fx:id="contentScroll" fitToHeight="true" fitToWidth="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <StackPane fx:id="contentArea" styleClass="content-area">
                        <padding>
                            <Insets bottom="25" left="30" right="30" top="25" />
                        </padding>
                    </StackPane>
                </ScrollPane>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>