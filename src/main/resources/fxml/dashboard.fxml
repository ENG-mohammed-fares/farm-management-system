<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartfarm.controller.DashboardController"
            prefWidth="1100" prefHeight="650"
            stylesheets="@../css/dashboard.css">

    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="230" spacing="4">

            <padding>
                <Insets top="25" right="0" bottom="25" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="logo-box">
                <padding>
                    <Insets bottom="30" left="10" right="15"/>
                </padding>
                <Label text="🌿" styleClass="logo-icon"/>
                <Label text="Smart Farm" styleClass="logo-text"/>
            </HBox>

            <Button fx:id="btnDashboard" text="🏠  Dashboard" styleClass="nav-btn,nav-active" maxWidth="Infinity" onAction="#showDashboard"/>
            <Button fx:id="btnFields" text="🌱  Fields &amp; Crops" styleClass="nav-btn" maxWidth="Infinity" onAction="#showFields"/>
            <Button fx:id="btnHarvests" text="🌾  Harvests" styleClass="nav-btn" maxWidth="Infinity" onAction="#showHarvests"/>
            <Button fx:id="btnWorkers" text="👷  Workers" styleClass="nav-btn" maxWidth="Infinity" onAction="#showWorkers"/>
            <Button fx:id="btnTransactions" text="💰  Transactions" styleClass="nav-btn" maxWidth="Infinity" onAction="#showTransactions"/>
            <Button fx:id="btnStorage" text="📦  Storage" styleClass="nav-btn" maxWidth="Infinity" onAction="#showStorage"/>
            <Button fx:id="btnFertilizers" text="👨🏼‍🌾  Fertilizers" styleClass="nav-btn" maxWidth="Infinity" onAction="#showFertilizers"/>
            <Button fx:id="btnHistory" text="📜  History" styleClass="nav-btn" maxWidth="Infinity" onAction="#showHistory"/>
            <Button fx:id="btnReports" text="📊  Reports" styleClass="nav-btn" maxWidth="Infinity" onAction="#showReports"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnSettings" text="🔧  Settings" styleClass="nav-btn" maxWidth="Infinity" onAction="#showSettings"/>
            <Button fx:id="btnQuit" text="🚪  Quit" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleQuit"/>

        </VBox>

        <VBox styleClass="main-area" HBox.hgrow="ALWAYS">

            <padding>
                <Insets top="15" right="15" bottom="15" left="0"/>
            </padding>

            <VBox styleClass="content-wrapper" VBox.vgrow="ALWAYS">

                <HBox styleClass="top-bar" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="18" right="30" bottom="18" left="30"/>
                    </padding>

                    <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="themeToggleBtn" styleClass="theme-btn" onAction="#handleThemeToggle">
                        <graphic>
                            <ImageView fx:id="themeIcon" fitWidth="24" fitHeight="24" preserveRatio="true">
                                <image>
                                    <Image url="@../images/sun.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <HBox alignment="CENTER" spacing="10" styleClass="user-box">
                        <padding>
                            <Insets left="20"/>
                        </padding>
                        <Label fx:id="userName" text="Admin" styleClass="user-name"/>
                    </HBox>

                </HBox>

                <ScrollPane fx:id="contentScroll" fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                    <StackPane fx:id="contentArea" styleClass="content-area">
                        <padding>
                            <Insets top="25" right="30" bottom="25" left="30"/>
                        </padding>
                    </StackPane>
                </ScrollPane>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>